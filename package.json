{
  "name": "metateam-code-agent",
  "version": "0.1.0",
  "description": "AI-powered, terminal-first coding assistant for MetaTeam engineers",
  "type": "module",
  "bin": {
    "mtc": "./bin/mtc.js"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build --compile --outfile bin/mtc src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test:eval": "bun run src/cli.tsx eval"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "figlet": "^1.11.4",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "typescript": "^7.0.2"
  }
}
