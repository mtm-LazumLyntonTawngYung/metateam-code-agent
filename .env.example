# Microsoft Entra ID SSO (device-code flow)
MTC_AZURE_CLIENT_ID=enter-your-azure-client-id
MTC_AZURE_TENANT_ID=enter-your-azure-tenant-id
MTC_AZURE_CLIENT_SECRET=enter-your-azure-client-secret

# LLM provider keys are configured via `mtc llm set-provider`
# (stored in ~/.config/mtc/config.json) — not environment variables.

# Daemon (mtc daemon)
MTC_GITHUB_TOKEN=ghp_enter-your-token
MTC_GITLAB_TOKEN=enter-your-gitlab-token
MTC_WEBHOOK_SECRET=enter-your-webhook-secret
MTC_SLACK_WEBHOOK=https://hooks.slack.com/services/...
MTC_TEAMS_WEBHOOK=https://your-org.webhook.office.com/...

# WebSocket server (mtc serve)
MTC_WS_TOKEN=enter-your-ws-token

# Enterprise licensing
MTC_LICENSE_SECRET=enter-your-license-signing-secret

# Bundled MCP bridges
FIGMA_TOKEN=figd_enter-your-figma-token
DATADOG_API_KEY=enter-your-datadog-api-key
DATADOG_APP_KEY=enter-your-datadog-app-key
AWS_ACCESS_KEY_ID=enter-your-aws-access-key
AWS_SECRET_ACCESS_KEY=enter-your-aws-secret-key
